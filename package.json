{
  "name": "@lloyal-labs/lloyal.node",
  "version": "4.1.1",
  "description": "The Node runtime for the HDK — built on liblloyal and llama.cpp",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "gypfile": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "download-models": "bash scripts/download-test-models.sh",
    "build:native": "node scripts/build.js",
    "build:ts": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "build": "npm run build:ts && npm run build:native",
    "build:debug": "cmake-js compile --debug",
    "rebuild": "cmake-js rebuild",
    "clean": "cmake-js clean && rm -rf build_test/ dist/",
    "version": "node scripts/sync-versions.js && git add -A",
    "docs": "npx typedoc",
    "test": "npm run test:integration",
    "test:unit": "npx tsx test/backend-pack-unit.ts && npx tsx test/peers-unit.ts && npx tsx test/prepare-unit.ts",
    "test:canary": "npx tsx test/stderr-canary.ts",
    "test:integration": "npx tsx test/integration.ts",
    "test:audio": "tsx --test test/audio-integration.ts",
    "test:embedding": "tsx --test test/embedding-integration.ts",
    "test:scenarios": "tsx --test test/scenario-integration.ts",
    "test:images": "tsx test/integration.ts --suite=image",
    "test:examples": "npx tsx test/examples.ts",
    "sync:llama-cpp": "node scripts/sync-llama-cpp.js",
    "example": "npx tsx examples/chat/chat.ts",
    "prepare": "node scripts/install-hooks.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyal-ai/lloyal.node.git"
  },
  "keywords": [
    "llama",
    "llama.cpp",
    "liblloyal",
    "napi",
    "native",
    "inference",
    "llm"
  ],
  "author": "lloyal.ai",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lloyal-ai/lloyal.node/issues"
  },
  "homepage": "https://github.com/lloyal-ai/lloyal.node#readme",
  "dependencies": {
    "@lloyal-labs/tsampler": "^0.2.0",
    "node-addon-api": "^8.5.0"
  },
  "peerDependencies": {
    "@lloyal-labs/sdk": ">=5.0.0-0 <6.0.0"
  },
  "devDependencies": {
    "@lloyal-labs/hickey": "^0.2.1",
    "@lloyal-labs/sdk": "^5.0.0",
    "@types/node": "^25.3.0",
    "@types/semver": "^7.8.0",
    "cmake-js": "^8.0.0",
    "glob": "^11.0.0",
    "lefthook": "^2.2.2",
    "semver": "^7.8.5",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@lloyal-labs/lloyal.node-darwin-arm64": "4.1.1",
    "@lloyal-labs/lloyal.node-darwin-x64": "4.1.1",
    "@lloyal-labs/lloyal.node-linux-arm64": "4.1.1",
    "@lloyal-labs/lloyal.node-linux-arm64-cuda": "4.1.1",
    "@lloyal-labs/lloyal.node-linux-arm64-vulkan": "4.1.1",
    "@lloyal-labs/lloyal.node-linux-x64": "4.1.1",
    "@lloyal-labs/lloyal.node-linux-x64-cuda": "4.1.1",
    "@lloyal-labs/lloyal.node-linux-x64-vulkan": "4.1.1",
    "@lloyal-labs/lloyal.node-win32-arm64": "4.1.1",
    "@lloyal-labs/lloyal.node-win32-arm64-vulkan": "4.1.1",
    "@lloyal-labs/lloyal.node-win32-x64": "4.1.1",
    "@lloyal-labs/lloyal.node-win32-x64-cuda": "4.1.1",
    "@lloyal-labs/lloyal.node-win32-x64-vulkan": "4.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/",
    "scripts/",
    "LICENSE",
    "NOTICE",
    "LICENSE-FAQ.md"
  ]
}
