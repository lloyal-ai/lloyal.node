{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["test/**/*.ts"],
  // audio-integration.ts and embedding-integration.ts are typed by the SDK that declares audio, video
  // and encodeMultimodal, which ships from hdk after this addon. They run under tsx (npm run test:audio,
  // npm run test:embedding) and rejoin this gate when that SDK is a devDependency.
  "exclude": ["node_modules", "dist", "build", "test/audio-integration.ts", "test/embedding-integration.ts"]
}
