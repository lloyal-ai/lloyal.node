{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["test/**/*.ts"],
  // audio-integration.ts is typed by the SDK that declares audio, which ships from hdk after this
  // addon. It runs under tsx (npm run test:audio) and rejoins this gate when that SDK is a devDependency.
  "exclude": ["node_modules", "dist", "build", "test/audio-integration.ts"]
}
